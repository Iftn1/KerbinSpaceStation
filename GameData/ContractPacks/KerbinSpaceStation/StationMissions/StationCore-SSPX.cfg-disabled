@CONTRACT_TYPE[StationCoreSSPX]:NEEDS[Kopernicus,StationPartsExpansionRedux]
{
	@PARAMETER[NewStation]
	{
		@PARAMETER[LKO]
		{
            %maxAltitude = @/targetBody1.IsSun() ? 113549713200 : @/targetBody1.SpaceAltitudeThreshold()
		}
	}
}
CONTRACT_TYPE:NEEDS[StationPartsExpansionRedux]
{

	DATA
	{
		type = string
		hidden = true

		loc_KSS_StationCoreSSPX_title_s1 = #loc_KSS_StationCoreSSPX_title_s1
		loc_KSS_StationCoreSSPX_title_s2 = #loc_KSS_StationCoreSSPX_title_s2
		loc_KSS_shared_In_order_to_aid_our_efforts_of_exploring = #loc_KSS_shared_In_order_to_aid_our_efforts_of_exploring
		loc_KSS_shared_we_d_like_you_to_launch_a_space_station = #loc_KSS_shared_we_d_like_you_to_launch_a_space_station
		loc_KSS_StationCoreSSPX_synopsis_s1 = #loc_KSS_StationCoreSSPX_synopsis_s1
		loc_KSS_shared_Space_Station = #loc_KSS_shared_Space_Station
		loc_KSS_shared_Launch_a_new_Station_Core_into_the_specified_orb = #loc_KSS_shared_Launch_a_new_Station_Core_into_the_specified_orb
	}

    name = StationCoreSSPX
    group = BasesandStations
    title = @/loc_KSS_StationCoreSSPX_title_s1 + @/targetBody1 + @/loc_KSS_StationCoreSSPX_title_s2
	genericTitle = #loc_KSS_shared_Launch_a_New_Space_Station
    description = @/loc_KSS_shared_In_order_to_aid_our_efforts_of_exploring + @/targetBody1 + @/loc_KSS_shared_we_d_like_you_to_launch_a_space_station
	genericDescription = #loc_KSS_shared_We_d_like_you_to_deploy_a_new_space_station
    synopsis = @/loc_KSS_StationCoreSSPX_synopsis_s1 + @/targetBody1 + @/loc_KSS_shared_Space_Station
    completedMessage = #loc_KSS_shared_Station_Complete
    
	// Contract min/max expiry in days.
    minExpiry = 1
    maxExpiry = 7
    // Contract can be cancelled and declined.
    cancellable = true
    declinable = true
    targetBody = @/targetBody1

     maxSimultaneous = 3
      
    // Contract rewards - no science random other rewards.
    rewardScience = 0
    rewardReputation = Random(1.0, 10.0)
    rewardFunds = Random(100000.0, 150000.0)
    failureReputation = Random(1.0, 100.0)
    failureFunds = 50000.0
    advanceFunds = 50000.0

    // Failsafe Data.
    DATA
    {
        type = List<Vessel>
		requiredValue = false
        stations = AllVessels().Where(v => v.VesselType() == Station)
    }
    DATA
    {
        type = CelestialBody
        requiredValue = true
        uniquenessCheck = GROUP_ACTIVE
        targetBody1 = OrbitedBodies().Where(body => @/stations.Where(v => v.CelestialBody() == body).Count() == 0).SelectUnique()
		//targetBody1 = Kerbin
		title = #loc_KSS_StationCoreSSPX_DATA2_title
    }


    //Checks all vessel parameters are correct
    PARAMETER
    {
        name = NewStation
        type = VesselParameterGroup
        title = @/loc_KSS_shared_Launch_a_new_Station_Core_into_the_specified_orb + @/targetBody1.
        notes = #loc_KSS_StationCoreSSPX_PARAMETER1_notes

		//Checks station is in orbit
		PARAMETER
        {
            name = LKO
            type = Orbit
          
			targetBody = @/targetBody1
            situation = ORBITING
			maxAltitude = @/targetBody1.IsSun() ? 113549713200 : @/targetBody1 == Gilly ? 16000 : @/targetBody1.SpaceAltitudeThreshold()
        }

        //Check for a Docking Port
		PARAMETER
		{
			name = PartValidation
			type = PartValidation
			
			partModule = ModuleDockingNode
			minCount = 1
		}
		
		//Check for crew capacity
        PARAMETER
        {
            name = HabModuleChild
            type = HasCrewCapacity
			title = #loc_KSS_shared_Support_4_Kerbals
            
			minCapacity = 4
            
        }
		
		//Checks that vessel can generate power, accepts solar panels or RTGs
        PARAMETER
        {
            name = RTGSolar
            type = Any
            title = #loc_KSS_shared_Have_one_of_the_following_power_generators

            PARAMETER
            {
                name = PartValidationRTG
                type = PartValidation
				title = #loc_KSS_shared_1_or_more_solar_panels
				hideChildren = true

                partModule = ModuleDeployableSolarPanel
                minCount = 1
            }
                
            PARAMETER
            {
                name = PartValidationSolar
                type = PartValidation
                title = #loc_KSS_shared_1_or_more_generators
				hideChildren = true
                
                partModule = ModuleGenerator
                minCount = 1
            }
			
			PARAMETER:NEEDS[NearFutureSolar]
			{
				name = PartValidationNearFutureSolar
				type = PartValidation
				title = #loc_KSS_shared_1_or_more_curved_solar_panels
				hideChildren = true
				
				partModule = ModuleCurvedSolarPanel
				minCount = 1
			}
			
			PARAMETER:NEEDS[NearFutureElectrical]
			{
				name = PartValidationNearFutureReactors
				type = PartValidation
				title = #loc_KSS_shared_1_or_more_fission_reactors
				hideChildren = true
				partModule = FissionReactor
				minCount = 1
			}
			
			PARAMETER:NEEDS[NearFutureElectrical]
			{
				name = PartValidationNearFutureRTGs
				type = PartValidation
				title = #loc_KSS_shared_1_or_more_radioisotope_generators
				hideChildren = true
				partModule = ModuleRadioisotopeGenerator
				minCount = 1
			}
			
			PARAMETER:NEEDS[Kopernicus]
			{
				name = PartValidationRTG
                type = PartValidation
                hideChildren = true
                title = #loc_KSS_shared_1_or_more_solar_panels
                partModule = KopernicusSolarPanel
                minCount = 1
			}
        }

		// checks for sspxr station core and habitat
		PARAMETER:NEEDS[StationPartsExpansionRedux]
		{
			name = StationCoreAndHabValidation
			type = Any
			optional = false
            title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_title_3

            PARAMETER
            {
                name = PartValidationHab125
                type = All

                PARAMETER
                {
                    name = PartValidationStationCore125
                    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER1_PARAMETER1_title
				    hideChildren = true
			
				    part = sspx-core-125-1	
				    minCount = 1
			    }

			    PARAMETER
			    {
				    name = PartValidationHab125
				    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER1_PARAMETER2_title_2
				    hideChildren = true
				
				    part = sspx-habitation-125-1		
				    part = sspx-inflatable-centrifuge-125-1
				    part = sspx-inflatable-centrifuge-125-2					
				    part = sspx-inflatable-hab-125-1
				    part = sspx-inflatable-hab-125-2
				    part = sspx-inflatable-hab-125-3
				    
			    	minCount = 1						
			    }
	    	}

            PARAMETER
            {
                name = PartValidationHab1875
                type = All

                PARAMETER
                {
                    name = PartValidationStationCore1875
                    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER2_PARAMETER1_title
				    hideChildren = true
			
				    part = sspx-core-1875-1				
				    minCount = 1
			    }

			    PARAMETER
			    {
				    name = PartValidationHab1875
				    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER2_PARAMETER2_title_2
				    hideChildren = true
				
				    part = sspx-habitation-1875-1
				    part = sspx-habitation-1875-2

			    	minCount = 1						
			    }
			}

            PARAMETER
            {
                name = PartValidationHab25
                type = All

                PARAMETER
                {
                    name = PartValidationStationCore25
                    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER3_PARAMETER1_title
				    hideChildren = true
			
				    part = sspx-core-25-1
				
				    minCount = 1
			    }

			    PARAMETER
			    {
				    name = PartValidationHab25
				    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER3_PARAMETER2_title_2
				    hideChildren = true

				    part = sspx-habitation-25-1
				    part = crewCabin
				    part = sspx-inflatable-centrifuge-25-1
				    part = sspx-inflatable-hab-25-1
				    part = sspx-inflatable-hab-25-2

			    	minCount = 1						
			    }
			}
            
            PARAMETER
            {
                name = PartValidationHab375
                type = All

                PARAMETER
                {
                    name = PartValidationStationCore375
                    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER4_PARAMETER1_title
				    hideChildren = true

				    part = sspx-core-375-1

				    minCount = 1
			    }

			    PARAMETER
			    {
				    name = PartValidationHab375
				    type = PartValidation
				    title = #loc_KSS_shared_Include_a_habitat_module
				    hideChildren = true
				
				    part = sspx-habitation-375-1
				    part = sspx-habitation-375-2
				    part = sspx-habitation-375-3
				    part = sspx-expandable-centrifuge-375-1
			    	part = sspx-expandable-centrifuge-375-2

			    	minCount = 1						
			    }
			}
			
            PARAMETER
            {
                name = PartValidationHab5
                type = All

                PARAMETER
                {
                    name = PartValidationStationCore5
                    type = PartValidation
				    title = #loc_KSS_StationCoreSSPX_PARAMETER1_PARAMETER1_PARAMETER5_PARAMETER1_title
				    hideChildren = true
			
				    part = sspx-core-5-1
				
				    minCount = 1
			    }

			    PARAMETER
			    {
				    name = PartValidationHab5
				    type = PartValidation
				    title = #loc_KSS_shared_Include_a_habitat_module
				    hideChildren = true
				
				    part = sspx-habitation-5-1
			    	part = sspx-habitation-5-2
			    	part = sspx-expandable-centrifuge-5-1

			    	minCount = 1						
			    }
			}
        }

		//OPTIONAL Checks for cupola
		PARAMETER
        {
            name = PartValidation
            type = PartValidation
            title = #loc_KSS_shared_Include_a_cupola_not_optional
			optional = true
			hideChildren = true
            
// Can add multiple "part" lines here will match on ANY of them
			part = sspx-dome-cupola-5-1
			part = sspx-cupola-greenhouse-125-1
			part = sspx-observation-25-1
			part = sspx-cupola-125-1
			part = sspx-cupola-375-1
			part = sspx-cupola-1875-1

            minCount = 1
            
        }
		
		//Checks for Supplies (USI Life Support)
		PARAMETER:NEEDS[USILifeSupport]
		{
			name = Supplies
			type = HasResource
			title = #loc_KSS_shared_Have_Supplies_on_board_your_vessel
			
			resource = Supplies
			minQuantity = 1
		}
		
		//OPTIONAL Checks for science labs from various mods
		PARAMETER
		{
			name = ScienceModuleValidation
			type = Any
			optional = true
			completeInSequence = true
			
			PARAMETER
			{
				name = ScienceLab
				type = PartValidation
				title = #loc_KSS_shared_Include_a_Mobile_Processing_Lab_MPL_LG_2
				rewardFunds = 75000.0
				hideChildren = true
				
				partModule = ModuleScienceLab
			}

			PARAMETER:NEEDS[StationScience]
			{
				name = PartValidation
				type = PartValidation
				title = #loc_KSS_shared_Include_a_TH_NKR_Research_Lab
				rewardFunds = 85000.0
				hideChildren = true
				
				part = StnSciLab
			}
			
			PARAMETER:NEEDS[Kerbalism]
			{
				name = PartValidation
				type = PartValidation
				title = #loc_KSS_shared_Include_a_Science_Laboratory
				rewardFunds = 75000.0
				hideChildren = true

				partModule = Laboratory
			}
		}
		
		PARAMETER
		{
			name = VesselIsType
			type = VesselIsType
			
			vesselType = Station
		}
	
	}

	//Begins a 2-day countdown. Station must be in orbit for 2 days for contract to complete
	PARAMETER
	{
		name = Duration
		type = Duration
		duration = 2d
		preWaitText = #loc_KSS_shared_Orbit_time_required
		waitingText = #loc_KSS_shared_Time_to_completion
		completionText = #loc_KSS_shared_You_survived
		startCriteria = PARAMETER_COMPLETION
		parameter = NewStation
	}
	
	
	REQUIREMENT
	{
		name = PartModuleUnlocked
		type = PartModuleUnlocked

		partModule = ModuleDockingNode
	}

	REQUIREMENT
	{
		name = Any
		type = Any
	
		REQUIREMENT
		{
			name = PartModuleUnlocked
			type = PartModuleUnlocked
			
			partModule = ModuleDeployableSolarPanel
		}
		
		//REQUIREMENT:NEEDS[Kopernicus]
		//{
		//	name = PartModuleUnlocked
		//	type = PartModuleUnlocked
		//	
		//	partModule = KopernicusSolarPanel
		//}
		
		REQUIREMENT:NEEDS[NearFutureSolar]
		{
			name = PartModuleUnlocked
			type = PartModuleUnlocked
			
			partModule = ModuleCurvedSolarPanel
		}	
	}
	
	// REQUIREMENT
	// {
		// name = CompleteContract
		// type = CompleteContract
		// contractType = StationCore
		// minCount = 0
		// checkOnActiveContract = false
		// cooldownDuration = 5d
		// title = Must not have completed this contract in the last 5 days.
	// }

	REQUIREMENT
	{
		name = PartUnlocked
		type = PartUnlocked
		
		part = crewCabin
	}
	
	REQUIREMENT
	{
		name = SunCheck
		type = Expression
		expression = !@/targetBody1.IsSun()
		title = #loc_KSS_shared_Target_body_must_not_be_the_Sun
	}
}
	
